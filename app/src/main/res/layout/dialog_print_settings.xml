<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface_bg"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/print_settings_title"
            android:textColor="@color/on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/on_surface_variant"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/print_settings_desc"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Paper Size Section (Only A4 and A5) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/paper_format_label"
        android:textColor="@color/on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/dlgBtnA4"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="برگه A4 اداری\n(210 × 297 mm)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/emerald_600"
            android:background="@drawable/chip_active_bg"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/dlgBtnA5"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="برگه A5 نیم‌صفحه\n(148 × 210 mm)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:background="@drawable/chip_inactive_bg" />
    </LinearLayout>

    <!-- Orientation Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/orientation_label"
        android:textColor="@color/on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/dlgBtnPortrait"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/orientation_portrait"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/emerald_600"
            android:background="@drawable/chip_active_bg"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/dlgBtnLandscape"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/orientation_landscape"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:background="@drawable/chip_inactive_bg" />
    </LinearLayout>

    <!-- Apply & Close Button -->
    <Button
        android:id="@+id/dlgBtnApply"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="تأیید و اعمال تنظیمات برگه"
        android:textColor="@color/on_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/primary_button_bg" />
</LinearLayout>
