<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <!-- ========================================================== -->
    <!-- SCREEN 1: HOME DASHBOARD (صفحه اصلی اسکنر و فتوکپی)           -->
    <!-- ========================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="36dp">

            <!-- App Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_app_scanner"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/on_surface"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_subtitle"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="آفلاین • نیتیو"
                    android:textColor="@color/emerald_600"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <!-- Quick Paper Size Selection Bar on Home -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_bg"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paper_format_label"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHomePaperA4"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/paper_a4"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_600"
                        android:background="@drawable/chip_active_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnHomePaperA5"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/paper_a5"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:background="@drawable/chip_inactive_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnHomePaper2in1"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/paper_2in1"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant"
                        android:background="@drawable/chip_inactive_bg" />
                </LinearLayout>

            </LinearLayout>

            <!-- Main Actions Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسکن سریع مدارک"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Button 1: Start Camera Scan -->
                <Button
                    android:id="@+id/btnHomeStartScan"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/btn_start_scan"
                    android:textColor="@color/on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/primary_button_bg"
                    android:drawableStart="@android:drawable/ic_menu_camera"
                    android:drawableTint="@color/on_primary"
                    android:paddingHorizontal="18dp"
                    android:layout_marginBottom="10dp" />

                <!-- Button 2: Pick from Gallery -->
                <Button
                    android:id="@+id/btnHomePickGallery"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_pick_gallery"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:background="@drawable/secondary_button_bg"
                    android:drawableStart="@android:drawable/ic_menu_gallery"
                    android:drawableTint="@color/on_surface"
                    android:paddingHorizontal="18dp" />

            </LinearLayout>

            <!-- Recent Scans Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_scans_title"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txtEmptyRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_recent_scans"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Recent Document Card (Visible when at least one scan exists) -->
                <LinearLayout
                    android:id="@+id/layoutRecentDocument"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:padding="10dp"
                    android:background="@drawable/paper_mount_bg">

                    <ImageView
                        android:id="@+id/imgHomeRecentThumb"
                        android:layout_width="56dp"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:background="#FFFFFF"
                        android:contentDescription="تصویر مدرک اخیر" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="آخرین سند اسکن شده"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtRecentFormatInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="برگه آماده چاپ و ذخیره"
                            android:textColor="@color/emerald_600"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnHomeOpenRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="مشاهده برگه"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface"
                        android:background="@drawable/secondary_button_bg"
                        android:paddingHorizontal="12dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Professional Features Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/paper_mount_bg"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="امکانات فتوکپی و اسکن اداری:"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ الگوریتم فتوکپی پرکنتراست و حذف سایه‌ها"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ تنظیم خودکار قطع برگه A4 اداری و A5 نیم‌صفحه"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ حالت ۲ در ۱: چاپ رو و پشت کارت در یک برگه A4 با خط برش"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ ذخیره مستقیم با کیفیت در گالری دستگاه (JPEG) و فایل PDF"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ========================================================== -->
    <!-- SCREEN 2: CAMERA CAPTURE (صفحه عکاسی و اسکن مدرک)             -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- Camera Preview ViewFinder -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- Camera Top Overlay Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical"
            android:background="#80000000"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackFromCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="بازگشت"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/capture_photo"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/btn_star"
                android:contentDescription="@string/flash_mode"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="@string/switch_camera"
                app:tint="#FFFFFF"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Document Framing Guide Frame -->
        <View
            android:id="@+id/documentGuideFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/document_frame_border"
            app:layout_constraintDimensionRatio="1:1.414"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hint Overlay text -->
        <TextView
            android:id="@+id/txtGuideHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/align_document_hint"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#80000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/documentGuideFrame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Shutter Control Bar -->
        <LinearLayout
            android:id="@+id/bottomShutterBar"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#90000000"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Last capture thumbnail -->
            <ImageView
                android:id="@+id/imgLastCapture"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="@drawable/thumb_border"
                android:contentDescription="آخرین عکس"
                android:layout_marginEnd="32dp" />

            <!-- Shutter button -->
            <ImageButton
                android:id="@+id/btnCapture"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/shutter_ring_drawable"
                android:contentDescription="@string/capture_photo" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="32dp"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Flash blink animation overlay -->
        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================== -->
    <!-- SCREEN 3: CROP & PERSPECTIVE WARP (برش و اصلاح پرسپکتیو)      -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:visibility="gone">

        <!-- Crop Header -->
        <LinearLayout
            android:id="@+id/cropHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:background="#1E293B"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackFromCrop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF"
                android:contentDescription="بازگشت" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/crop_screen_title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="8dp" />

            <Button
                android:id="@+id/btnRotateCrop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="چرخش ۹۰°"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/secondary_button_bg"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnAutoCorners"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="کادر کامل"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/secondary_button_bg"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Crop Area with Interactive Corner Handles -->
        <FrameLayout
            android:id="@+id/cropContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toBottomOf="@id/cropHeader"
            app:layout_constraintBottom_toTopOf="@id/cropBottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgCropSource"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="تصویر اصلی مدرک برای برش" />

            <com.example.persiancamera.ui.CropOverlayView
                android:id="@+id/cropOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Crop Bottom Bar -->
        <LinearLayout
            android:id="@+id/cropBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1E293B"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/crop_screen_hint"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnApplyCrop"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_apply_crop"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/primary_button_bg" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================== -->
    <!-- SCREEN 4: RESULT SHEET & EXPORT (پیش‌نمایش برگه و فتوکپی)      -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone"
        android:elevation="12dp">

        <!-- Result Top Header -->
        <LinearLayout
            android:id="@+id/resultHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:elevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnResultHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/btn_back_home"
                app:tint="@color/on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp">

                <TextView
                    android:id="@+id/txtResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bw_result_title"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPaperBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="برگه A4 • عمودی"
                    android:textColor="@color/emerald_600"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenPrintSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_print_settings"
                android:textSize="11sp"
                android:textColor="@color/on_surface"
                android:background="@drawable/secondary_button_bg"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Quick Paper Size Bar in Result View -->
        <LinearLayout
            android:id="@+id/quickPaperBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:background="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/resultHeader">

            <Button
                android:id="@+id/btnPaperA4"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/paper_a4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/emerald_600"
                android:background="@drawable/chip_active_bg"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPaperA5"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/paper_a5"
                android:textSize="11sp"
                android:textColor="@color/on_surface_variant"
                android:background="@drawable/chip_inactive_bg"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPaper2in1"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/paper_2in1"
                android:textSize="10sp"
                android:textColor="@color/on_surface_variant"
                android:background="@drawable/chip_inactive_bg" />

        </LinearLayout>

        <!-- 2-in-1 Prompt Banner (Shown when 2-in-1 is selected) -->
        <LinearLayout
            android:id="@+id/layout2in1Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:background="#FEF3C7"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/quickPaperBar">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/two_in_one_prompt"
                android:textColor="#92400E"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAddBackDoc"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/btn_add_back_doc"
                android:textSize="11sp"
                android:textColor="#92400E"
                android:background="@drawable/secondary_button_bg"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Realistic Document Paper Mount & Sheet Preview -->
        <FrameLayout
            android:id="@+id/layoutPaperMount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            android:background="@drawable/paper_mount_bg"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/layout2in1Banner"
            app:layout_constraintBottom_toTopOf="@id/filterBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgResultBW"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/bw_image_desc" />

            <!-- Loading spinner while converting -->
            <ProgressBar
                android:id="@+id/progressConverting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Filter Mode Selector Chips (فتوکپی واضح / اسکن رنگی / خاکستری / اصلی) -->
        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@id/resultActionsBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnModePhotocopy"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="@string/filter_photocopy"
                android:textColor="@color/emerald_600"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/chip_active_bg"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeMagicColor"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="@string/filter_magic_color"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeGrayscale"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="@string/filter_grayscale"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeOriginal"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="@string/filter_original"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Professional Action Panel (Save to Gallery, PDF, Share, Rotate, Next) -->
        <LinearLayout
            android:id="@+id/resultActionsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:background="@color/surface"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- PROMINENT BUTTON: SAVE DIRECTLY TO GALLERY (JPEG) -->
            <Button
                android:id="@+id/btnSaveToGallery"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_save_to_gallery"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/gallery_save_button_bg"
                android:drawableStart="@android:drawable/ic_menu_save"
                android:drawableTint="@color/on_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Secondary Actions Row: PDF, Paper Settings, Share, Rotate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <!-- Export PDF -->
                <Button
                    android:id="@+id/btnExportPdf"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="@string/btn_save_pdf"
                    android:textColor="@color/on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/secondary_button_bg"
                    android:layout_marginEnd="6dp" />

                <!-- Paper Settings -->
                <Button
                    android:id="@+id/btnPaperSettings"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="تنظیمات کاغذ"
                    android:textColor="@color/on_surface"
                    android:textSize="11sp"
                    android:background="@drawable/secondary_button_bg"
                    android:layout_marginEnd="6dp" />

                <!-- Share -->
                <Button
                    android:id="@+id/btnShareDoc"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="@string/btn_share"
                    android:textColor="@color/on_surface"
                    android:textSize="11sp"
                    android:background="@drawable/secondary_button_bg"
                    android:layout_marginEnd="6dp" />

                <!-- Rotate Result 90 degrees -->
                <ImageButton
                    android:id="@+id/btnRotateResult"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="@drawable/secondary_button_bg"
                    android:contentDescription="چرخش ۹۰ درجه"
                    app:tint="@color/on_surface" />

            </LinearLayout>

            <!-- Bottom Button: Take Next Photo -->
            <Button
                android:id="@+id/btnNewPhoto"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/take_another_photo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/emerald_600"
                android:background="@drawable/chip_active_bg" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
