<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <!-- ========================================================== -->
    <!-- SCREEN 1: HOME DASHBOARD (صفحه اصلی و اولیه اپلیکیشن)        -->
    <!-- ========================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="40dp">

            <!-- App Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/round_icon_bg"
                    android:padding="10dp"
                    app:tint="@color/primary"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_subtitle"
                        android:textColor="#A0A0A0"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="آفلاین"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <!-- Main Actions Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_surface_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسکن سریع مدارک"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Button 1: Start Camera Scan -->
                <Button
                    android:id="@+id/btnHomeStartScan"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_start_scan"
                    android:textColor="@color/on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/primary_button_bg"
                    android:drawableStart="@android:drawable/ic_menu_camera"
                    android:drawableTint="@color/on_primary"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="12dp" />

                <!-- Button 2: Pick from Gallery -->
                <Button
                    android:id="@+id/btnHomePickGallery"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_pick_gallery"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/secondary_button_bg"
                    android:drawableStart="@android:drawable/ic_menu_gallery"
                    android:drawableTint="@color/on_surface"
                    android:paddingHorizontal="20dp" />

            </LinearLayout>

            <!-- Tip Card for Best Quality -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1510B981"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_title"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_body"
                    android:textColor="#D0D0D0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- Feature Tags -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✓ فتوکپی پرکنتراست"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✓ برش و صاف‌کردن کادر"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✓ خروجی PDF و عکس"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Recent Scans Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_scans_title"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/layoutRecentDocument"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_surface_bg"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgHomeRecentThumb"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/thumb_border"
                    android:contentDescription="آخرین مدرک اسکن شده" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp">

                    <TextView
                        android:id="@+id/txtHomeRecentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="آخرین مدرک اسکن شده"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHomeRecentDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="نسخه فتوکپی با کیفیت بالا"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnHomeOpenRecent"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="مشاهده"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtEmptyRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_recent_scans"
                android:textColor="#666666"
                android:textSize="12sp"
                android:gravity="center"
                android:padding="20dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================================================== -->
    <!-- SCREEN 2: CAMERA CAPTURE (صفحه عکاسی از مدرک)               -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Visual flash overlay effect -->
        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone" />

        <!-- Document Guide Rectangle -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/documentFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/document_frame_border"
            app:layout_constraintWidth_percent="0.86"
            app:layout_constraintDimensionRatio="1:1.42"
            app:layout_constraintTop_toBottomOf="@id/cameraTopBar"
            app:layout_constraintBottom_toTopOf="@id/cameraBottomControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtDocumentHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/align_document_hint"
                android:textColor="#E0FFFFFF"
                android:textSize="12sp"
                android:background="#80000000"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Camera Top Bar -->
        <LinearLayout
            android:id="@+id/cameraTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/overlay_bar"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackFromCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="بازگشت به خانه"
                app:tint="@color/on_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="کادر اسکن مدرک"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Flash Mode Toggle (خاموش پیش‌فرض) -->
            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="@string/flash_mode"
                app:tint="@color/on_primary" />

        </LinearLayout>

        <!-- Camera Bottom Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cameraBottomControls"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:paddingHorizontal="24dp"
            android:background="@color/overlay_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Last capture thumbnail -->
            <ImageView
                android:id="@+id/imgLastCapture"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                android:background="@drawable/thumb_border"
                android:contentDescription="@string/gallery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Shutter Button -->
            <ImageButton
                android:id="@+id/btnCapture"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/shutter_ring_drawable"
                android:contentDescription="@string/capture_photo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Switch Camera -->
            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="@string/switch_camera"
                app:tint="@color/on_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================================== -->
    <!-- SCREEN 3: CROP & CORNER ADJUSTMENT (تنظیم گوشه‌ها و کادر)   -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0A0A"
        android:visibility="gone"
        android:elevation="8dp">

        <!-- Crop Header -->
        <LinearLayout
            android:id="@+id/cropTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/overlay_bar"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackFromCrop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="انصراف از برش"
                app:tint="@color/on_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/crop_screen_title"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Rotate 90 Button -->
            <ImageButton
                android:id="@+id/btnRotateCrop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="@string/btn_rotate_crop"
                app:tint="@color/on_primary" />

        </LinearLayout>

        <!-- Crop Container (Image + Draggable Corner Overlay) -->
        <FrameLayout
            android:id="@+id/cropContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toBottomOf="@id/cropTopBar"
            app:layout_constraintBottom_toTopOf="@id/cropBottomControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgCropSource"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="تصویر مدرک جهت برش" />

            <com.example.persiancamera.ui.CropOverlayView
                android:id="@+id/cropOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Crop Bottom Actions -->
        <LinearLayout
            android:id="@+id/cropBottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center"
            android:background="@color/overlay_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Auto Corner Reset Button -->
            <Button
                android:id="@+id/btnAutoCorners"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/btn_auto_corners"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:background="@drawable/secondary_button_bg"
                android:layout_marginEnd="10dp" />

            <!-- Confirm Crop and Warp Button -->
            <Button
                android:id="@+id/btnApplyCrop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.6"
                android:text="@string/btn_apply_crop"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/primary_button_bg" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================================== -->
    <!-- SCREEN 4: PROFESSIONAL RESULT VIEW (صفحه نمایش اسکن حرفه‌ای)  -->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0C0C0C"
        android:visibility="gone"
        android:elevation="12dp">

        <!-- Result Top Header -->
        <LinearLayout
            android:id="@+id/resultHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/overlay_bar"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnResultHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/btn_back_home"
                app:tint="@color/on_primary" />

            <TextView
                android:id="@+id/txtResultTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bw_result_title"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/txtResultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bw_converted_badge"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- Scanned Document Image Display -->
        <ImageView
            android:id="@+id/imgResultBW"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/bw_image_desc"
            android:layout_margin="12dp"
            app:layout_constraintTop_toBottomOf="@id/resultHeader"
            app:layout_constraintBottom_toTopOf="@id/filterBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Loading spinner while converting -->
        <ProgressBar
            android:id="@+id/progressConverting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/imgResultBW"
            app:layout_constraintBottom_toBottomOf="@id/imgResultBW"
            app:layout_constraintStart_toStartOf="@id/imgResultBW"
            app:layout_constraintEnd_toEndOf="@id/imgResultBW" />

        <!-- Filter Mode Selector Chips (فتوکپی واضح / اسکن رنگی / خاکستری / اصلی) -->
        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="4dp"
            android:background="#99171717"
            app:layout_constraintBottom_toTopOf="@id/resultActionsBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnModePhotocopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_photocopy"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/chip_active_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeMagicColor"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_magic_color"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeGrayscale"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_grayscale"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeOriginal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_original"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <!-- Professional Action Row (PDF, Share, Rotate, Save) & Next Photo -->
        <LinearLayout
            android:id="@+id/resultActionsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="@color/overlay_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <!-- Export PDF -->
                <Button
                    android:id="@+id/btnExportPdf"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="@string/btn_save_pdf"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/secondary_button_bg"
                    android:layout_marginEnd="6dp" />

                <!-- Share -->
                <Button
                    android:id="@+id/btnShareDoc"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="@string/btn_share"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp"
                    android:background="@drawable/secondary_button_bg"
                    android:layout_marginEnd="6dp" />

                <!-- Rotate Result -->
                <ImageButton
                    android:id="@+id/btnRotateResult"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="@drawable/secondary_button_bg"
                    android:contentDescription="چرخش ۹۰ درجه"
                    app:tint="@color/on_surface" />

            </LinearLayout>

            <!-- Bottom Button to Scan Another Document -->
            <Button
                android:id="@+id/btnNewPhoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/take_another_photo"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:background="@drawable/primary_button_bg" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

