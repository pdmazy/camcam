<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <!-- Camera Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Visual flash blink effect on capture -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Document Guide Viewfinder Frame (کادر راهنمای مدرک شناسایی / کاغذ) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/documentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/document_frame_border"
        app:layout_constraintWidth_percent="0.86"
        app:layout_constraintDimensionRatio="1:1.42"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Alignment Hint Badge -->
        <TextView
            android:id="@+id/txtDocumentHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/align_document_hint"
            android:textColor="#E0FFFFFF"
            android:textSize="12sp"
            android:background="#80000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Overlay Header (RTL) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/overlay_bar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_compass"
            android:contentDescription="@string/flash_mode"
            app:tint="@color/on_primary" />

    </LinearLayout>

    <!-- Bottom Action Controls Bar (RTL) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:paddingHorizontal="24dp"
        android:background="@color/overlay_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Last captured photo thumbnail (RTL start) -->
        <ImageView
            android:id="@+id/imgLastCapture"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_border"
            android:contentDescription="@string/gallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Shutter Capture Button (Center) -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/shutter_ring_drawable"
            android:contentDescription="@string/capture_photo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Switch Camera (Front/Back) Button (RTL end) -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="@string/switch_camera"
            app:tint="@color/on_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Black & White Result View (سیاه و سفید) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Result Top Header -->
        <LinearLayout
            android:id="@+id/resultHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/overlay_bar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtResultTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bw_result_title"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical" />

            <TextView
                android:id="@+id/txtResultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bw_converted_badge"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- Black & White Image Display -->
        <ImageView
            android:id="@+id/imgResultBW"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/bw_image_desc"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/resultHeader"
            app:layout_constraintBottom_toTopOf="@id/resultBottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Loading spinner while converting -->
        <ProgressBar
            android:id="@+id/progressConverting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/imgResultBW"
            app:layout_constraintBottom_toBottomOf="@id/imgResultBW"
            app:layout_constraintStart_toStartOf="@id/imgResultBW"
            app:layout_constraintEnd_toEndOf="@id/imgResultBW" />

        <!-- Filter Mode Selector (انتخاب نوع اسکن فتوکپی) -->
        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="8dp"
            android:background="#99171717"
            app:layout_constraintBottom_toTopOf="@id/resultBottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnModePhotocopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_photocopy"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/chip_active_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeGrayscale"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_grayscale"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnModeOriginal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/filter_original"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="14dp" />

        </LinearLayout>

        <!-- Bottom Action Bar to take another photo -->
        <LinearLayout
            android:id="@+id/resultBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center"
            android:background="@color/overlay_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnNewPhoto"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/take_another_photo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:background="@drawable/primary_button_bg" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
